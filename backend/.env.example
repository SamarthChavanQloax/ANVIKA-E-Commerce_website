# ==========================================
# Anvika Boutique - Render Environment Variables
# ==========================================

# Port (Render sets this dynamically, defaults to 5001 for local development)
PORT=5001

# Application Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# MongoDB Atlas Connection URI (required)
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/anvika_boutique?retryWrites=true&w=majority

# JWT Secret Key for token signing and authentication (required)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL for CORS allowance (comma-separated if multiple)
# Example: https://anvika-26.onrender.com,https://yourcustomdomain.com
FRONTEND_URL=https://anvika-26.onrender.com

# PayPal Client ID (optional, defaults to 'sb' for sandbox)
PAYPAL_CLIENT_ID=sb

# Razorpay Configuration (required for production payment processing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Meta WhatsApp Cloud API Configuration
# Set WHATSAPP_ENABLED=true to send live messages; when false or unset, runs in safe Simulation/Mock Mode
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=anvika_wa_webhook_verify_secret
WHATSAPP_TEMPLATE_NAME_REMINDER_1=anvika_abandoned_cart_v1
WHATSAPP_TEMPLATE_NAME_REMINDER_2=anvika_abandoned_cart_v2
WHATSAPP_TEMPLATE_NAME_REMINDER_3=anvika_abandoned_cart_v3
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Abandoned Cart Timing Configuration (in minutes)
ABANDONED_CART_DELAY_MINUTES_STEP1=30
ABANDONED_CART_DELAY_MINUTES_STEP2=1440
ABANDONED_CART_DELAY_MINUTES_STEP3=2880
CART_RECOVERY_POLL_INTERVAL_MS=120000
