# ==========================================
# Anvika Boutique - Render Environment Variables
# ==========================================

# Port (Render sets this dynamically, defaults to 5001 for local development)
PORT=5001

# Application Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# MongoDB Atlas Connection URI (required)
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/anvika_boutique?retryWrites=true&w=majority

# JWT Secret Key for token signing and authentication (required)
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL for CORS allowance (comma-separated if multiple)
# Example: https://anvika-26.onrender.com,https://yourcustomdomain.com
FRONTEND_URL=https://anvika-26.onrender.com

# PayPal Client ID (optional, defaults to 'sb' for sandbox)
PAYPAL_CLIENT_ID=sb

# Razorpay Configuration (required for production payment processing)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
